[Unit]
Description=NAS Panel server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nas-panel
Group=nas-panel
# 磁盘设备访问及 ATA/SAT SMART 命令所需权限，仅对本服务生效。
SupplementaryGroups=disk
AmbientCapabilities=CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_RAWIO
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
WorkingDirectory=/opt/nas-panel
ExecStart=/opt/nas-panel/nas-panel-server -config /etc/nas-panel/config.json -web-dir /opt/nas-panel/web/dist -energy-file /var/lib/nas-panel/energy.json
Restart=on-failure
RestartSec=2
StateDirectory=nas-panel
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
